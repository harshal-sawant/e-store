# Sample environment variables for the Node server
# Copy this file to `.env` in the same folder and adjust values.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection (local example)
#MONGO_URI=mongodb://localhost:27017/estore
# For MongoDB Atlas use something like:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<dbName>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://harshalsawant2:Ecomm123@ecommercestorecluster.hsh964o.mongodb.net/?retryWrites=true&w=majority



# JWT / Auth
# Long, random secret used to sign tokens
JWT_SECRET=replace_with_a_long_random_string
# Token lifetime examples: 15m, 1h, 12h, 1d, 7d
JWT_LIFETIME=1d

# CORS (currently code allows '*'; you can tighten it by setting origin to this and updating app.js)
CORS_ORIGIN=http://localhost:4200

# Optional: Uncomment and wire up if you later add config usage
# UPLOADS_DIR=uploads

# ------------------------------------------------------------------
# After creating your real .env, DO NOT commit it to version control.
# ------------------------------------------------------------------
